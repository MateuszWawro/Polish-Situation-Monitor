{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "api/.venv/bin/uvicorn",
      "runtimeArgs": [
        "--app-dir",
        "api",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "web-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--host",
        "0.0.0.0"
      ],
      "port": 5174
    }
  ]
}