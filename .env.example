# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=psm
POSTGRES_USER=psm
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://psm:change-me@db:5432/psm
# Tests only: a dedicated, disposable DB (wiped on every pytest run). Never the one above.
TEST_DATABASE_URL=postgresql+psycopg://psm@localhost:5433/psm_test
REDIS_URL=redis://redis:6379/0
# Contact sent in User-Agent to data sources (email or project URL)
INGEST_CONTACT=change-me@example.com
